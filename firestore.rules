rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── USERS ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── BUSINESSES ───────────────────────────────────────────────────────
    match /businesses/{businessId} {
      // Anyone can read approved businesses
      allow read: if resource.data.status == 'approved' || isAdmin()
                  || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      // Any signed-in user can submit a business (goes to pending)
      allow create: if isSignedIn()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ownerId == request.auth.uid;
      // Owner can update their own (not status), admin can update anything,
      // any signed-in user can bump the aggregate rating fields when they review
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
                    || isAdmin()
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']));
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
                    || isAdmin();
    }

    // ── PRODUCTS (marketplace) ──────────────────────────────────────────
    match /products/{productId} {
      // Anyone can read approved products
      allow read: if resource.data.status == 'approved' || isAdmin()
                  || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      // Any signed-in user can list a product (goes to pending)
      allow create: if isSignedIn()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ownerId == request.auth.uid;
      // Owner can update their own (not status), admin can update anything
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
                    || isAdmin();
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
                    || isAdmin();
    }

    // ── LIKES ────────────────────────────────────────────────────────────
    match /likes/{userId}/items/{businessId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── PRODUCT LIKES (marketplace favorites) ───────────────────────────
    match /users/{userId}/likes/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── REVIEWS ──────────────────────────────────────────────────────────
    match /reviews/{businessId}/items/{reviewId} {
      // Anyone can read reviews (public, matches business detail page)
      allow read: if true;
      // Any signed-in user can leave a review, attributed to themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the author can edit their own review (userId can't be reassigned)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      // Author can delete their own review, admin can delete any review
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ── SELLER RATINGS (marketplace) ────────────────────────────────────
    match /sellerRatings/{sellerId}/items/{reviewId} {
      // Anyone can read seller reviews (public, matches product detail page)
      allow read: if true;
      // Any signed-in user can leave a review, attributed to themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the author can edit their own review (userId can't be reassigned)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      // Author can delete their own review, admin can delete any review
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ── TOURIST SITES ────────────────────────────────────────────────────
    match /touristSites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── EVENTS ───────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── USEFUL NUMBERS (About Burkina) ──────────────────────────────────
    match /usefulNumbers/{numberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── OFFICIAL GOVERNMENT SITES (About Burkina) ───────────────────────
    match /officialSites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── USEFUL APPLICATIONS ──────────────────────────────────────────────
    match /usefulApps/{appId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── PUSH TOKENS ──────────────────────────────────────────────────────
    // Toute installation s'enregistre, connectée ou non : c'est le seul moyen
    // de prévenir les visiteurs qui n'ont pas de compte. Trois garde-fous
    // compensent l'écriture ouverte :
    //   - l'ID du document doit être le jeton lui-même (pas d'écriture en
    //     rafale sous des IDs choisis au hasard),
    //   - seuls trois champs sont acceptés, aucun ne pouvant servir de stockage,
    //   - la lecture reste réservée à l'admin ; l'envoi passe par le SDK Admin
    //     (scripts/notify-new.js), qui ignore ces règles.
    match /pushTokens/{token} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
                            && request.resource.data.token == token
                            && token.size() < 200;
      allow delete: if isAdmin();
    }

    // ── REPORTS ──────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Only admins can view the moderation queue
      allow read: if isAdmin();
      // Any signed-in user can file a report, attributed to themselves
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      // Only admin can dismiss/resolve (delete) a report
      allow delete: if isAdmin();
    }
  }
}
